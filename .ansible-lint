---
# Lint baseline.
#
# The five legacy roles under roles/ are being rewritten phase by phase
# (see docs/PLAN.md). Each phase removes its role from exclude_paths and
# guarantees zero findings for that role before the next phase starts.
profile: production

exclude_paths:
  - .agents/
  - .ansible/
  - .cache/
  - .docker/
  - .venv/
  - molecule/*/.molecule/
  # Remaining legacy roles, rewritten phase by phase (docs/PLAN.md).
  - roles/libvirt/

skip_list:
  # The snapshot role intentionally consumes the project-wide configuration
  # (confirm_restore, vm_*, timeshift_root) so destructive-path validation can
  # be audited in one place, and emits resolved_snapshot for the rest of the
  # pipeline. Prefixing those would hide the real interface.
  - var-naming[no-role-prefix]
