---
# Lint baseline.
#
# Roles under roles/ are linted incrementally; each one leaves exclude_paths
# once it meets the production profile with zero findings.
profile: production

exclude_paths:
  - .agents/
  - .ansible/
  - .cache/
  - .docker/
  - .venv/
  - molecule/*/.molecule/
  # Remaining legacy roles, rewritten incrementally.
  - roles/libvirt/

skip_list:
  # The snapshot role intentionally consumes the project-wide configuration
  # (confirm_restore, vm_*, timeshift_root) so destructive-path validation can
  # be audited in one place, and emits resolved_snapshot for the rest of the
  # pipeline. Prefixing those would hide the real interface.
  - var-naming[no-role-prefix]
