<domain type="kvm">
  <name>{{ vm_name }}</name>

  <memory unit="MiB">{{ vm_memory_mib }}</memory>
  <currentMemory unit="MiB">{{ vm_memory_mib }}</currentMemory>

  <memoryBacking>
    <source type="memfd"/>
    <access mode="shared"/>
  </memoryBacking>

  <vcpu placement="static">{{ vm_vcpus }}</vcpu>

  <os>
    <type arch="x86_64"{% if libvirt_machine | length > 0 %} machine="{{ libvirt_machine }}"{% endif %}>hvm</type>
    <loader readonly="yes" secure="no" type="pflash">{{ ovmf_code }}</loader>
    <nvram>{{ nvram_file }}</nvram>
    <boot dev="hd"/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <vmport state="off"/>
  </features>

  <cpu mode="host-passthrough" check="none" migratable="on"/>

  <clock offset="utc">
    <timer name="rtc" tickpolicy="catchup"/>
    <timer name="pit" tickpolicy="delay"/>
    <timer name="hpet" present="no"/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <pm>
    <suspend-to-mem enabled="no"/>
    <suspend-to-disk enabled="no"/>
  </pm>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2" discard="unmap"/>
      <source file="{{ vm_disk }}"/>
      <target dev="vda" bus="virtio"/>
    </disk>

{% if libvirt_attach_iso | bool %}
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <source file="{{ arch_iso }}"/>
      <target dev="sda" bus="sata"/>
      <readonly/>
    </disk>
{% endif %}

    <controller type="usb" model="qemu-xhci" ports="15"/>
    <controller type="pci" index="0" model="pci-root"/>

    <interface type="network">
      <source network="{{ network_name }}"/>
      <model type="virtio"/>
    </interface>

    <serial type="pty">
      <target type="isa-serial" port="0">
        <model name="isa-serial"/>
      </target>
    </serial>
    <console type="pty">
      <target type="serial" port="0"/>
    </console>

    <channel type="unix">
      <target type="virtio" name="org.qemu.guest_agent.0"/>
    </channel>

{% if libvirt_graphics == 'spice' %}
    <channel type="spicevmc">
      <target type="virtio" name="com.redhat.spice.0"/>
    </channel>
    <input type="tablet" bus="usb"/>
    <input type="mouse" bus="ps2"/>
    <input type="keyboard" bus="ps2"/>
    <graphics type="spice" autoport="yes">
      <listen type="address"/>
      <image compression="off"/>
{% if libvirt_gl_enable | bool %}
      <gl enable="yes" rendernode="{{ libvirt_spice_rendernode }}"/>
{% endif %}
    </graphics>
    <sound model="ich9"/>
    <audio id="1" type="spice"/>
    <video>
      <model type="virtio" heads="1" primary="yes"/>
    </video>
    <redirdev bus="usb" type="spicevmc"/>
    <redirdev bus="usb" type="spicevmc"/>
{% elif libvirt_graphics == 'vnc' %}
    <graphics type="vnc" port="-1" autoport="yes" listen="0.0.0.0"/>
    <input type="tablet" bus="usb"/>
    <input type="mouse" bus="ps2"/>
    <input type="keyboard" bus="ps2"/>
    <video>
      <model type="vga" heads="1" primary="yes"/>
    </video>
{% else %}
    {# Headless mode: omit graphics; the shared serial/console remains available. #}
{% endif %}

    <memballoon model="virtio"/>
    <rng model="virtio">
      <backend model="random">/dev/urandom</backend>
    </rng>
  </devices>
</domain>
